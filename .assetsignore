# Kept out of the served static bundle (assets.directory is the repo root).
# Only the landing page and the demo board ship: index.html, demo/.
#
# This list is an *exclusion* list, which fails in the one direction nobody notices:
# a file nobody thought about is not left out, it is published. It did — node_modules/
# (113 tracked files, playwright-core included) and package.json were both live on
# etapp.tor2dbear.com, verified 200. `npm run check` now asserts this list instead of
# trusting it.
.git
.gitignore
.assetsignore
wrangler.jsonc
README.md
demo/data/build.mjs
scripts
# The repo's own roadmap — pucks are source, harvested by tor2dbear/roadmap.
# They are not part of the site, and the guard caught them the moment they existed.
roadmap
# CI. The gate that runs the guard on every PR, so removing the guard is a diff
# someone has to approve rather than an edit in a dashboard nobody can review.
.github
# The suite. Node's own runner, no install — see tests/bundle.test.mjs for why the
# guard needed one of its own.
tests
# The demo's fictional pucks and their config: input to demo/data/build.mjs, never
# served. Only its *output* (demo/data/roadmap.{json,js}) ships. Anchored on purpose —
# the bare `roadmap` line above already swallowed fixture/repos/**/roadmap/*.md by
# accident, which is the right outcome reached by a pattern that means something else.
demo/data/fixture
.DS_Store
node_modules
package.json
package-lock.json
.wrangler
wrangler-out.txt
